<%- include('../partials/header') %>

<main class="faculty-container">
    <h1>Faculty Directory</h1>
    
    <div class="sort-controls">
        <label for="sortSelect">Sort By:</label>
        <select id="sortSelect" onchange="location = this.value;">
            <option value="/faculty?sortBy=name" <%= sortBy === 'name' ? 'selected' : '' %>>Name</option>
            <option value="/faculty?sortBy=department" <%= sortBy === 'department' ? 'selected' : '' %>>Department</option>
            <option value="/faculty?sortBy=title" <%= sortBy === 'title' ? 'selected' : '' %>>Title</option>
        </select>
    </div>

    <div class="faculty-grid">
        <% if (facultyList && facultyList.length > 0) { %>
            <% facultyList.forEach(member => { %>
                <div class="faculty-card">
                    <h2><a href="/faculty/<%= member.id %>"><%= member.name %></a></h2>
                    <p><strong>Department:</strong> <%= member.department %></p>
                    <p><strong>Title:</strong> <%= member.title %></p>
                    <p><strong>Office:</strong> <%= member.office %></p>
                    <a href="/faculty/<%= member.id %>" class="view-profile-btn">View Profile &rarr;</a>
                </div>
            <% }); %>
        <% } else { %>
            <p>No faculty members found.</p>
        <% } %>
    </div>
</main>

<%- include('../partials/footer') %>
